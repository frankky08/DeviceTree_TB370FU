# Diagnostic markers for TB370FU boot-stage verification via /dev/kmsg (pstore/ramoops).
# Non-destructive: no partition writes, no forced reboots.
on early-init
    write /dev/kmsg "TB370FU_BOOTDIAG event=early_init_rc"

on init
    write /dev/kmsg "TB370FU_BOOTDIAG event=init_rc"

on fs
    write /dev/kmsg "TB370FU_BOOTDIAG event=fs_rc"

on post-fs
    write /dev/kmsg "TB370FU_BOOTDIAG event=post_fs_rc"

on property:ro.cold_boot_done=true
    write /dev/kmsg "TB370FU_BOOTDIAG event=coldboot_property"

on property:init.svc.recovery=running
    write /dev/kmsg "TB370FU_BOOTDIAG event=recovery_service_running"

on property:sys.usb.state=adb
    write /dev/kmsg "TB370FU_BOOTDIAG event=usb_state_adb"

on property:sys.usb.state=fastboot
    write /dev/kmsg "TB370FU_BOOTDIAG event=usb_state_fastboot"
