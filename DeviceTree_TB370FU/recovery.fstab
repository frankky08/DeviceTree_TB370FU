#
# Copyright (C) 2024-2026 OrangeFox Recovery Project
#
# Recovery fstab for Lenovo Tab P12 (TB370FU / mt6877 / mt8791)
# Grounded in stock_boot_preserved/ramdisk/first_stage_ramdisk/fstab.mt6877,
# stock_vendor_reference/etc/fstab.mt6877, and stock_evidence/scatter_partitions.json.
#

# <mount_point>        <fstype>  <device>                           <flags>

# Dynamic Logical Partitions (Super / A/B Slot-Selected)
/system_root           ext4      system                             flags=display="System";logical;slotselect;backup=1;flashimg=1
/vendor                ext4      vendor                             flags=display="Vendor";logical;slotselect;backup=1;flashimg=1
/product               ext4      product                            flags=display="Product";logical;slotselect;backup=1;flashimg=1

# Super Raw Partition (for full Super backup/flash)
/super                 emmc      /dev/block/by-name/super           flags=display="Super (Dynamic)";backup=1;flashimg=1

# Metadata & Userdata (F2FS + FBEv2 inlinecrypt_optimized + metadata_encryption as in stock fstab.mt6877)
/metadata              ext4      /dev/block/by-name/metadata        flags=display="Metadata";backup=1;wipeingui
/data                  f2fs      /dev/block/by-name/userdata        flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;fsflags="noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt"

# Core A/B Boot & Verified Boot Partitions
/boot                  emmc      /dev/block/by-name/boot            flags=display="Boot";slotselect;backup=1;flashimg=1
/dtbo                  emmc      /dev/block/by-name/dtbo            flags=display="DTBO";slotselect;backup=1;flashimg=1
/vbmeta                emmc      /dev/block/by-name/vbmeta          flags=display="VBMeta";slotselect;backup=1;flashimg=1
/vbmeta_system         emmc      /dev/block/by-name/vbmeta_system   flags=display="VBMeta System";slotselect;backup=1;flashimg=1
/vbmeta_vendor         emmc      /dev/block/by-name/vbmeta_vendor   flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1

# Vendor Calibration, Persist, NVRAM & Lenovo Custom Partitions (Critical Backup Targets)
/persist               ext4      /dev/block/by-name/persist         flags=display="Persist";backup=1;flashimg=1
/nvram                 emmc      /dev/block/by-name/nvram           flags=display="NVRAM";backup=1;flashimg=1
/nvdata                ext4      /dev/block/by-name/nvdata          flags=display="NVData";backup=1
/nvcfg                 ext4      /dev/block/by-name/nvcfg           flags=display="NVCfg";backup=1
/protect_f             ext4      /dev/block/by-name/protect1        flags=display="Protect1";backup=1
/protect_s             ext4      /dev/block/by-name/protect2        flags=display="Protect2";backup=1
/proinfo               emmc      /dev/block/by-name/proinfo         flags=display="Proinfo";backup=1
/lenovocust            ext4      /dev/block/by-name/lenovocust      flags=display="LenovoCust";backup=1
/lenovoraw             emmc      /dev/block/by-name/lenovoraw       flags=display="LenovoRaw";backup=1
/logo                  emmc      /dev/block/by-name/logo            flags=display="Logo";backup=1;flashimg=1
/seccfg                emmc      /dev/block/by-name/seccfg          flags=display="SecCfg";backup=1
/tee                   emmc      /dev/block/by-name/tee             flags=display="TEE";slotselect;backup=1
/persistent            emmc      /dev/block/by-name/frp             flags=display="FRP";backup=1
/para                  emmc      /dev/block/by-name/para            flags=display="Para"
/misc                  emmc      /dev/block/by-name/misc            flags=display="Misc"
/boot_para             emmc      /dev/block/by-name/boot_para       flags=display="Boot_Para"

# Removable Storage (MicroSD & USB-OTG using stock sysfs paths + TWRP v2 syntax)
/devices/platform/externdevice*  /external_sd  auto  defaults       voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/usb0*          /usb-otg      auto  nosuid,nodev   voldmanaged=usbotg:auto,storage,removable
